  "music": {
    "code_path": "OP4 dlls/triggers.cpp PlayCDTrack() sends engine 'cd play <track>' (and 'cd stop' for -1). The engine, not the game DLL, maps the track ID to media/*.mp3. Shipped autoexec.cfg/op4weapons.cfg contain no cd/mp3/media command.",
    "diagnosis": "The ZIP contains no media/*.mp3 and no gamestartup.mp3. GoldSrc looks in the active mod's media/ folder and then valve/media; fallback_dir gearbox supplies maps/models/sounds but is not a reliable media/ lookup for CD/MP3 tracks. Earlier, the intro played Half-Life music. Later, the music worked and was the OP4 soundtrack.",
    "engine_behavior_sources": [
      "https://developer.valvesoftware.com/wiki/List_of_HL1_soundtracks",
      "https://twhl.info/wiki/page/Tutorial:_Making_Music_Play_in_Maps_[GoldSource]/5984",
      "https://github.com/UCyborg/hl-mp3-fix"
    ],
    "fix": "setup_op4_media.bat copies only the user's original gearbox/media/*.mp3 (plus gearbox_downloads/media/*.mp3 when present) into lambda-fix/media/. No track is invented, renamed, or downloaded.",
    "runtime_test": "works on my machine (OP4 music plays); not run in this environment",
    "startup_music": "gamestartup.mp3 is copied only if the installed OP4 copy provides it; it is never fabricated."
  },
  "package_policy": {
    "bundled_legal_assets": [],
    "in_game_tested_here": false,
    "music_setup": "setup_op4_media.bat copies the original OP4 MP3s into <mod>/media/; no MP3 is generated or bundled",
    "music_source": "user's installed Half-Life/gearbox/media/*.mp3 (and gearbox_downloads/media when present)",
    "required_docs": [
      "SOURCE_AUDIT.md",
      "RUNTIME_TESTS.md",
      "INSTALL.md"
    ],
    "required_setup": [
      "setup_op4_media.bat"
    ]
  },
  "penguin": {
