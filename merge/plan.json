{
  "schema": 2,
  "name": "bugfixhl-x-op4-speedrun",
  "target": "op4",
  "description": "Port BugfixedHL bugfixes and speedrun tooling onto the Opposing Force SDK. Whole-file merges are replaced by machine-verified equivalence audits plus curated, compiled injections; no unresolved conflicts remain.",
  "rules": [
    {
      "id": "audit-movement",
      "action": "audit",
      "path": "pm_shared/pm_shared.cpp",
      "feature": "bunnyhop / movement bugfixes",
      "evidence": "BugfixedHL src/pm_shared/pm_shared.cpp:2662-2777 (s_bBHopCap) == OP4 pm_shared/pm_shared.cpp:2541-2669 (physinfo \"bj\" + sv_allowbunnyhopping)",
      "expect": [
        { "meaning": "OP4-native bunnyhop toggle read from physinfo", "pattern": "PM_Info_ValueForKey(pmove->physinfo, \"bj\")" },
        { "meaning": "vanilla mega-bunny-jump speed cap is implemented", "pattern": "void PM_PreventMegaBunnyJumping()" },
        { "meaning": "speed cap factor is defined", "pattern": "BUNNYJUMP_MAX_SPEED_FACTOR", "min": 2 },
        { "meaning": "cap is invoked from PM_Jump", "pattern": "PM_PreventMegaBunnyJumping();" }
      ]
    },
    {
      "id": "audit-client",
      "action": "audit",
      "path": "dlls/client.cpp",
      "feature": "client command crash fixes",
      "evidence": "BugfixedHL src/game/server/client.cpp:648-686 == OP4 dlls/client.cpp:670-686; OP4 additionally syncs sv_allowbunnyhopping at line 985",
      "expect": [
        { "meaning": "bounded copy of unknown command prevents overflow", "pattern": "check the length of the command (prevents crash)" },
        { "meaning": "command buffer is explicitly terminated", "pattern": "command[127] = '\\0';" },
        { "meaning": "server-side bunnyhop cvar is synced to physinfo", "pattern": "sv_allowbunnyhopping.value" }
      ]
    },
    {
      "id": "audit-hud",
      "action": "audit",
      "path": "cl_dll/hud.cpp",
      "feature": "HUD init state fixes",
      "evidence": "BugfixedHL src/game/client/hud.cpp:343-350 (m_pSpriteList=NULL, m_flTime=1.0) == OP4 cl_dll/hud.cpp:384,415 + hud.h:719 constructor",
      "expect": [
        { "meaning": "HUD init resets logo state", "pattern": "m_iLogo = 0;" },
        { "meaning": "HUD time is seeded before the first update", "pattern": "m_flTime = 1.0;" },
        { "meaning": "HUD message hooks are registered in Init", "pattern": "HOOK_MESSAGE(Logo);" }
      ]
    },
    {
      "id": "port-bhl-timer-cpp",
      "action": "copy",
      "from": "bugfixhl:src/game/client/hud/timer.cpp",
      "path": "integration/ports/bhl_timer.cpp",
      "banner": true,
      "note": "GPL-3.0 reference for the timer HUD idea; ship our own game_shared/sr_core.*"
    },
    {
      "id": "port-bhl-timer-h",
      "action": "copy",
      "from": "bugfixhl:src/game/client/hud/timer.h",
      "path": "integration/ports/bhl_timer.h",
      "banner": true
    },
    {
      "id": "port-bhl-demo-cpp",
      "action": "copy",
      "from": "bugfixhl:src/game/client/demo.cpp",
      "path": "integration/ports/bhl_demo.cpp",
      "banner": true,
      "note": "Auto demo recording reference; implemented as sr_autodemo"
    },
    {
      "id": "port-bhl-convar-cpp",
      "action": "copy",
      "from": "bugfixhl:src/common/convar.cpp",
      "path": "integration/ports/bhl_convar.cpp",
      "include_rewrites": [["src/", ""]],
      "banner": true
    },
    {
      "id": "port-bhl-convar-h",
      "action": "copy",
      "from": "bugfixhl:src/common/convar.h",
      "path": "integration/ports/bhl_convar.h",
      "banner": true
    },
    {
      "id": "ports-readme",
      "action": "copy",
      "from": "repo:integration/ports/README.md",
      "path": "integration/ports/README.md"
    },
    {
      "id": "core-header",
      "action": "copy",
      "from": "repo:src/speedrun/sr_core.h",
      "path": "game_shared/sr_core.h",
      "feature": "clean-room speedrun core"
    },
    {
      "id": "core-source",
      "action": "copy",
      "from": "repo:src/speedrun/sr_core.cpp",
      "path": "game_shared/sr_core.cpp",
      "feature": "clean-room speedrun core"
    },
    {
      "id": "core-route-data",
      "action": "copy",
      "from": "repo:src/speedrun/sr_route_data.h",
      "path": "game_shared/sr_route_data.h",
      "feature": "generated OP4 chapter/map route"
    },
    {
      "id": "client-hud-header",
      "action": "copy",
      "from": "overlay:cl_dll/sr_hud_timer.h",
      "path": "cl_dll/sr_hud_timer.h",
      "feature": "timer HUD"
    },
    {
      "id": "client-hud-source",
      "action": "copy",
      "from": "overlay:cl_dll/sr_hud_timer.cpp",
      "path": "cl_dll/sr_hud_timer.cpp",
      "feature": "timer HUD"
    },
    {
      "id": "client-msg-header",
      "action": "copy",
      "from": "overlay:cl_dll/sr_hud_msg.h",
      "path": "cl_dll/sr_hud_msg.h",
      "feature": "authoritative split network message"
    },
    {
      "id": "client-msg-source",
      "action": "copy",
      "from": "overlay:cl_dll/sr_hud_msg.cpp",
      "path": "cl_dll/sr_hud_msg.cpp",
      "feature": "authoritative split network message"
    },
    {
      "id": "server-header",
      "action": "copy",
      "from": "overlay:dlls/sr_server.h",
      "path": "dlls/sr_server.h",
      "feature": "authoritative server timer"
    },
    {
      "id": "server-source",
      "action": "copy",
      "from": "overlay:dlls/sr_server.cpp",
      "path": "dlls/sr_server.cpp",
      "feature": "authoritative server timer"
    },
    {
      "id": "gen-speedrun-cfg",
      "action": "generate",
      "path": "gamedir/speedrun.cfg",
      "generator": "speedrun_cfg"
    },
    {
      "id": "gen-route-json",
      "action": "generate",
      "path": "gamedir/splits/op4_route.json",
      "generator": "route_json"
    },
    {
      "id": "inject-hud-include",
      "action": "inject",
      "path": "cl_dll/hud.cpp",
      "anchor": "#include \"hud.h\"",
      "where": "after",
      "snippet": "repo:integration/snippets/hud_include.snippet",
      "feature": "wire the timer HUD + split message into CHud"
    },
    {
      "id": "inject-hud-msg-hook",
      "action": "inject",
      "path": "cl_dll/hud.cpp",
      "anchor": "void CHud::Init()\n{\n",
      "where": "after",
      "snippet": "repo:integration/snippets/hud_msg_hook.snippet",
      "feature": "hook the SRSplit user message"
    },
    {
      "id": "inject-hud-init",
      "action": "inject",
      "path": "cl_dll/hud.cpp",
      "anchor": "void CHud::Init()\n{\n",
      "where": "after",
      "snippet": "repo:integration/snippets/hud_init.snippet",
      "feature": "wire the timer HUD into CHud"
    },
    {
      "id": "inject-redraw-include",
      "action": "inject",
      "path": "cl_dll/hud_redraw.cpp",
      "anchor": "#include \"hud.h\"",
      "where": "after",
      "snippet": "repo:integration/snippets/redraw_include.snippet"
    },
    {
      "id": "inject-redraw-call",
      "action": "inject",
      "path": "cl_dll/hud_redraw.cpp",
      "anchor": "bool CHud::Redraw(float flTime, bool intermission)\n{\n",
      "where": "after",
      "snippet": "repo:integration/snippets/redraw.snippet"
    },
    {
      "id": "inject-world-include",
      "action": "inject",
      "path": "dlls/world.cpp",
      "anchor": "#include \"extdll.h\"",
      "where": "after",
      "snippet": "repo:integration/snippets/server_include.snippet"
    },
    {
      "id": "inject-world-spawn",
      "action": "inject",
      "path": "dlls/world.cpp",
      "anchor": "void CWorld::Spawn()\n{\n",
      "where": "after",
      "snippet": "repo:integration/snippets/world_spawn.snippet",
      "feature": "start/continue the run on map spawn"
    },
    {
      "id": "inject-client-include",
      "action": "inject",
      "path": "dlls/client.cpp",
      "anchor": "#include \"extdll.h\"",
      "where": "after",
      "snippet": "repo:integration/snippets/server_include.snippet"
    },
    {
      "id": "inject-client-putinserver",
      "action": "inject",
      "path": "dlls/client.cpp",
      "anchor": "void ClientPutInServer(edict_t* pEntity)\n{\n",
      "where": "after",
      "snippet": "repo:integration/snippets/client_putinserver.snippet",
      "feature": "reject runs with sv_cheats enabled"
    },
    {
      "id": "inject-usermessages",
      "action": "inject",
      "path": "dlls/UserMessages.cpp",
      "anchor": "gmsgShowGameTitle = REG_USER_MSG(\"GameTitle\", 1);",
      "where": "after",
      "snippet": "repo:integration/snippets/usermessages.snippet",
      "feature": "register SRSplit before clients hook it"
    }
  ]
}
