#ifndef __APPVERSION_H__
#define __APPVERSION_H__

/* Lambda Fix release version. Pinned here on purpose: GitVersionSemverfier
 * derives the version from `git describe --tags`, and this repository has no
 * tags, so the generated value was stale no matter what the package version
 * was.
 *
 * THIS MUST MATCH THE PACKAGE VERSION. The About page prints exactly these
 * three numbers, so if this line is not bumped the About page lies about which
 * build is running - which is how releases 1.0.6 through 1.1.2 all shipped
 * showing "1.0.5". Bump it in the same commit as the package. */
#define LF_VERSION "1.1.5"
#define APP_VERSION LF_VERSION

// For client.rc
#define APP_VERSION_C @GIT_MAJOR@,@GIT_MINOR@,@GIT_PATCH@,@GIT_SKIP@
#define APP_VERSION_FLAGS 0x0L

#endif
